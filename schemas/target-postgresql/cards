{
  "table_name": "cards",
  "database": "PostgreSQL",
  "columns": [
    {
      "column_name": "payment_instrument_key",
      "data_type": "BIGINT",
      "identity": "GENERATED BY DEFAULT AS IDENTITY",
      "primary_key": true,
      "nullable": false
    },
    {
      "column_name": "ledger_key",
      "data_type": "BIGINT",
      "nullable": false,
      "foreign_key": {
        "referenced_table": "accounts",
        "referenced_column": "ledger_key"
      }
    },
    {
      "column_name": "instrument_suffix",
      "data_type": "CHAR",
      "length": 4,
      "nullable": false
    },
    {
      "column_name": "instrument_category",
      "data_type": "VARCHAR",
      "length": 10,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "DEBIT",
          "CREDIT"
        ]
      }
    },
    {
      "column_name": "activation_date",
      "data_type": "DATE",
      "nullable": true
    },
    {
      "column_name": "expiry_date",
      "data_type": "DATE",
      "nullable": true
    },
    {
      "column_name": "instrument_state",
      "data_type": "VARCHAR",
      "length": 10,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "ACTIVE",
          "BLOCKED",
          "EXPIRED"
        ]
      }
    }
  ],
  "constraints": [
    {
      "constraint_name": "cards_pkey",
      "constraint_type": "PRIMARY KEY",
      "columns": [
        "payment_instrument_key"
      ]
    },
    {
      "constraint_name": "cards_ledger_key_fkey",
      "constraint_type": "FOREIGN KEY",
      "columns": [
        "ledger_key"
      ],
      "referenced_table": "accounts",
      "referenced_columns": [
        "ledger_key"
      ]
    },
    {
      "constraint_name": "cards_ledger_key_instrument_suffix_key",
      "constraint_type": "UNIQUE",
      "columns": [
        "ledger_key",
        "instrument_suffix"
      ]
    },
    {
      "constraint_name": "cards_instrument_category_check",
      "constraint_type": "CHECK",
      "column": "instrument_category",
      "condition": "instrument_category IN ('DEBIT', 'CREDIT')"
    },
    {
      "constraint_name": "cards_instrument_state_check",
      "constraint_type": "CHECK",
      "column": "instrument_state",
      "condition": "instrument_state IN ('ACTIVE', 'BLOCKED', 'EXPIRED')"
    }
  ]
}