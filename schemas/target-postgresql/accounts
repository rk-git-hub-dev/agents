{
  "table_name": "accounts",
  "database": "PostgreSQL",
  "columns": [
    {
      "column_name": "ledger_key",
      "data_type": "BIGINT",
      "identity": "GENERATED BY DEFAULT AS IDENTITY",
      "primary_key": true,
      "nullable": false
    },
    {
      "column_name": "client_key",
      "data_type": "BIGINT",
      "nullable": false,
      "foreign_key": {
        "referenced_table": "customers",
        "referenced_column": "client_key"
      }
    },
    {
      "column_name": "ledger_reference",
      "data_type": "VARCHAR",
      "length": 34,
      "unique": true,
      "nullable": false
    },
    {
      "column_name": "ledger_category",
      "data_type": "VARCHAR",
      "length": 20,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "CURRENT",
          "SAVINGS",
          "CREDIT"
        ]
      }
    },
    {
      "column_name": "ledger_currency",
      "data_type": "CHAR",
      "length": 3,
      "nullable": false
    },
    {
      "column_name": "available_funds",
      "data_type": "NUMERIC",
      "precision": 15,
      "scale": 2,
      "nullable": false
    },
    {
      "column_name": "activation_date",
      "data_type": "DATE",
      "nullable": true
    },
    {
      "column_name": "ledger_state",
      "data_type": "VARCHAR",
      "length": 20,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "OPEN",
          "FROZEN",
          "CLOSED"
        ]
      }
    }
  ],
  "constraints": [
    {
      "constraint_name": "accounts_pkey",
      "constraint_type": "PRIMARY KEY",
      "columns": [
        "ledger_key"
      ]
    },
    {
      "constraint_name": "accounts_client_key_fkey",
      "constraint_type": "FOREIGN KEY",
      "columns": [
        "client_key"
      ],
      "referenced_table": "customers",
      "referenced_columns": [
        "client_key"
      ]
    },
    {
      "constraint_name": "ledger_reference_unique",
      "constraint_type": "UNIQUE",
      "columns": [
        "ledger_reference"
      ]
    },
    {
      "constraint_name": "accounts_ledger_category_check",
      "constraint_type": "CHECK",
      "column": "ledger_category",
      "condition": "ledger_category IN ('CURRENT', 'SAVINGS', 'CREDIT')"
    },
    {
      "constraint_name": "accounts_ledger_state_check",
      "constraint_type": "CHECK",
      "column": "ledger_state",
      "condition": "ledger_state IN ('OPEN', 'FROZEN', 'CLOSED')"
    }
  ]
}