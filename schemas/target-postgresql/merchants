{
  "table_name": "merchants",
  "database": "PostgreSQL",
  "columns": [
    {
      "column_name": "payee_key",
      "data_type": "BIGINT",
      "identity": "GENERATED BY DEFAULT AS IDENTITY",
      "primary_key": true,
      "nullable": false
    },
    {
      "column_name": "payee_details",
      "data_type": "VARCHAR",
      "length": 255,
      "nullable": false
    },
    {
      "column_name": "payee_category",
      "data_type": "VARCHAR",
      "length": 20,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "GROCERY",
          "RETAIL",
          "UTILITIES",
          "TRAVEL",
          "DINING",
          "OTHER"
        ]
      }
    },
    {
      "column_name": "operating_country",
      "data_type": "CHAR",
      "length": 2,
      "nullable": true
    }
  ],
  "constraints": [
    {
      "constraint_name": "merchants_pkey",
      "constraint_type": "PRIMARY KEY",
      "columns": [
        "payee_key"
      ]
    },
    {
      "constraint_name": "merchants_payee_category_check",
      "constraint_type": "CHECK",
      "column": "payee_category",
      "condition": "payee_category IN ('GROCERY', 'RETAIL', 'UTILITIES', 'TRAVEL', 'DINING', 'OTHER')"
    }
  ]
}