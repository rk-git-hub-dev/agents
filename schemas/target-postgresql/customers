{
  "table_name": "customers",
  "database": "PostgreSQL",
  "columns": [
    {
      "column_name": "client_key",
      "data_type": "BIGINT",
      "identity": "GENERATED BY DEFAULT AS IDENTITY",
      "primary_key": true,
      "nullable": false
    },
    {
      "column_name": "client_full_name",
      "data_type": "VARCHAR",
      "length": 101,
      "nullable": false
    },
    {
      "column_name": "contact_email",
      "data_type": "VARCHAR",
      "length": 255,
      "unique": true,
      "nullable": false
    },
    {
      "column_name": "contact_phone",
      "data_type": "VARCHAR",
      "length": 30,
      "nullable": true
    },
    {
      "column_name": "birth_date",
      "data_type": "DATE",
      "nullable": true
    },
    {
      "column_name": "registration_timestamp",
      "data_type": "TIMESTAMP WITHOUT TIME ZONE",
      "nullable": true
    },
    {
      "column_name": "client_state",
      "data_type": "VARCHAR",
      "length": 20,
      "nullable": false,
      "check_constraint": {
        "allowed_values": [
          "ACTIVE",
          "INACTIVE",
          "SUSPENDED"
        ]
      }
    }
  ],
  "constraints": [
    {
      "constraint_name": "customers_pkey",
      "constraint_type": "PRIMARY KEY",
      "columns": [
        "client_key"
      ]
    },
    {
      "constraint_name": "contact_email_unique",
      "constraint_type": "UNIQUE",
      "columns": [
        "contact_email"
      ]
    },
    {
      "constraint_name": "customers_client_state_check",
      "constraint_type": "CHECK",
      "column": "client_state",
      "condition": "client_state IN ('ACTIVE', 'INACTIVE', 'SUSPENDED')"
    }
  ]
}